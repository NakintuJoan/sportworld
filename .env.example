# SQLite database file location (relative to project root)
SPORTSHUB_DB_PATH=./data/sportworld.db

# Set to "supabase" once you have a project, or leave as "sqlite"
DB_DRIVER=sqlite

# Supabase (only needed when DB_DRIVER=supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Admin access -----------------------------------------------------------
# Password for the /admin area. At least 8 characters, and make it long: this
# is the only thing between a stranger and your feed list. /admin/login shows
# these instructions if this is unset, and the write endpoints refuse requests
# rather than falling open.
ADMIN_PASSWORD=

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty the password is used as the signing key, which is acceptable
# but means changing the password signs everyone out.
SESSION_SECRET=

# Shared secret for scheduled ingest runs. A cron service cannot hold a
# session cookie, so it sends this as a bearer token instead:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-site.com/api/ingest
# Optional: without it, only an admin session can trigger a run.
CRON_SECRET=

# Max age of an article before the pruner deletes it (hours). Default 336 = 14 days.
RETENTION_HOURS=336
